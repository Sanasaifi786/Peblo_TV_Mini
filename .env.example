# ==============================================================================
# Peblo TV Mini - Environment Variables (.env.example)
# ==============================================================================
#
# SECRETS MANAGEMENT IN PRODUCTION:
# In production, sensitive secrets (such as JWT_SECRET, R2_ACCESS_KEY_ID, 
# R2_SECRET_ACCESS_KEY, and the production DATABASE_URL credentials) MUST NEVER 
# be checked into Git or stored in plaintext .env files on hosts.
# Instead, manage them using a centralized secret manager (e.g., AWS Secrets 
# Manager, HashiCorp Vault, Doppler, or Cloudflare Secrets). During deployment 
# (via GitHub Actions / Kubernetes secrets / ECS Task Definitions), inject these 
# values directly into the container runtime as environment variables. Database 
# credentials should ideally leverage short-lived IAM-authenticated role tokens, 
# and encryption keys should be rotated automatically on a regular schedule.
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg://peblo:peblo@db:5432/peblo_tv

# --- JWT Authentication ---
JWT_SECRET=peblo-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Storage Engine (local | r2) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
STORAGE_BASE_URL=http://localhost:8000/storage

# --- Cloudflare R2 / S3 Credentials (Required only when STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=peblo-catalogues
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Frontend API Targets ---
VITE_API_URL=http://localhost:8000
